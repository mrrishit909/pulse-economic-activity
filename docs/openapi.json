         "from",
         "to"
        ],
        "properties": {
         "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         },
         "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
         },
         "stepDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31,
          "default": 7
         },
         "commodity": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Default Response",
