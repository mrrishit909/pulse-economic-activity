  "/v1/playback": {
   "post": {
    "summary": "Pre-aggregated frames for timeline playback (lane volumes and port congestion per step)",
    "tags": [
     "flows"
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
