  "/v1/ingest/vessel-events": {
   "post": {
    "summary": "Upload up to 5,000 private vessel events; each is resolved to a vessel and a port",
    "tags": [
     "ingest"
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "events"
        ],
        "properties": {
         "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "items": {
           "type": "object",
           "required": [
            "event",
            "t"
           ],
           "properties": {
            "imo": {
             "type": "string"
            },
            "mmsi": {
             "type": "string"
            },
            "name": {
             "type": "string"
            },
            "port": {
             "type": "string"
            },
            "lat": {
             "type": "number"
            },
            "lon": {
             "type": "number"
            },
            "event": {
             "type": "string",
             "enum": [
              "arrival",
              "departure"
             ]
            },
            "t": {
             "type": "string",
             "format": "date-time"
            },
            "draught": {
             "type": "number"
            }
           }
          }
         }
        }
       }
      }
     }
    },
    "parameters": [
     {
      "schema": {
       "type": "string",
       "minLength": 8,
       "maxLength": 128
