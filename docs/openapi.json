{
 "openapi": "3.1.0",
 "info": {
  "title": "PULSE API",
  "version": "1.0.0",
  "description": "Synthetic trade flows, port congestion and regional activity nowcasts. Anonymous calls see data delayed by 30 days; a bearer token sees the latest. Mutations need an Idempotency-Key. Errors are {error:{code,message,traceId}}. Lists page with ?limit and ?cursor (nextCursor)."
 },
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer"
   }
  },
  "schemas": {}
 },
 "paths": {
  "/v1/bundle": {
   "get": {
    "summary": "The whole synthetic bundle the web app loads (gzip)",
    "tags": [
     "data"
    ],
    "parameters": [
     {
      "schema": {
       "type": "string",
       "enum": [
        "outage"
       ]
      },
      "in": "query",
      "name": "simulate",
      "required": false
     }
    ],
    "responses": {
     "200": {
      "description": "Default Response"
     }
    }
   }
  },
  "/v1/flows": {
   "get": {
    "summary": "Lane-day cargo flows (kt) with value and confidence",
    "tags": [
     "flows"
    ],
    "parameters": [
     {
      "schema": {
       "type": "string"
      },
      "in": "query",
      "name": "commodity",
      "required": false
     },
     {
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "in": "query",
      "name": "from",
      "required": false
     },
     {
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "in": "query",
      "name": "to",
      "required": false
     },
     {
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "in": "query",
      "name": "date",
      "required": false
     },
     {
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 2000,
       "default": 500
      },
      "in": "query",
      "name": "limit",
      "required": false
     },
     {
      "schema": {
       "type": "string"
      },
      "in": "query",
      "name": "cursor",
      "required": false
     }
    ],
    "responses": {
     "200": {
      "description": "Default Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "items"
         ],
         "properties": {
          "items": {
           "type": "array",
           "items": {
            "type": "object",
            "required": [
             "laneId",
             "from",
             "to",
             "commodity",
             "date",
             "kt"
            ],
            "properties": {
             "laneId": {
              "type": "integer"
             },
             "from": {
              "type": "string"
             },
             "to": {
              "type": "string"
             },
             "commodity": {
              "type": "string"
             },
             "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
             },
             "kt": {
              "type": "number"
             },
             "valueUsd": {
              "type": "number"
             },
             "confidence": {
              "type": "number"
             },
             "voyages": {
              "type": "integer"
             }
            }
           }
          },
          "nextCursor": {
           "type": [
            "null",
            "string"
           ]
          },
          "delayedTo": {
           "type": [
            "null",
            "string"
           ]
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Default Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "error"
         ],
         "properties": {
          "error": {
           "type": "object",
           "required": [
            "code",
            "message"
           ],
           "properties": {
            "code": {
             "type": "string"
            },
            "message": {
             "type": "string"
            },
            "traceId": {
             "type": "string"
            },
            "details": {}
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/v1/ports": {
   "get": {
    "summary": "Ports, optionally within km of a point (PostGIS)",
    "tags": [
