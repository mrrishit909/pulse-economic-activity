      "in": "query",
      "name": "near",
      "required": false
     },
     {
      "schema": {
       "type": "number",
       "minimum": 1,
       "maximum": 20000,
       "default": 500
      },
      "in": "query",
      "name": "km",
      "required": false
     }
    ],
    "responses": {
     "200": {
      "description": "Default Response",
